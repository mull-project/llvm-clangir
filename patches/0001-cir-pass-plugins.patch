diff --git a/clang/include/clang/CIR/CIRPassPlugin.h b/clang/include/clang/CIR/CIRPassPlugin.h
new file mode 100644
index 000000000..ddde63878
--- /dev/null
+++ b/clang/include/clang/CIR/CIRPassPlugin.h
@@ -0,0 +1,46 @@
+//===----------------------------------------------------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Out-of-tree CIR passes. A clang plugin (-fplugin=foo.so) registers a
+// CIRPassPlugin, and every CIR compilation lets it add passes to the
+// CIR-to-CIR pipeline:
+//
+//   static cir::CIRPassPluginRegistry::Add<MyPlugin> X("my-plugin", "...");
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef CLANG_CIR_CIRPASSPLUGIN_H
+#define CLANG_CIR_CIRPASSPLUGIN_H
+
+#include "clang/Support/Compiler.h"
+#include "llvm/Support/Registry.h"
+
+namespace mlir {
+class OpPassManager;
+} // namespace mlir
+
+namespace cir {
+
+class CIRPassPlugin {
+public:
+  virtual ~CIRPassPlugin() = default;
+
+  /// Add passes that run on the module right after CIRGen, before any
+  /// built-in CIR-to-CIR pass.
+  virtual void registerPasses(mlir::OpPassManager &pm) = 0;
+};
+
+using CIRPassPluginRegistry = llvm::Registry<CIRPassPlugin>;
+
+} // namespace cir
+
+namespace llvm {
+extern template class CLANG_TEMPLATE_ABI Registry<cir::CIRPassPlugin>;
+} // namespace llvm
+
+#endif // CLANG_CIR_CIRPASSPLUGIN_H
diff --git a/clang/lib/CIR/Lowering/CIRPasses.cpp b/clang/lib/CIR/Lowering/CIRPasses.cpp
index 6e75ce03d..404800554 100644
--- a/clang/lib/CIR/Lowering/CIRPasses.cpp
+++ b/clang/lib/CIR/Lowering/CIRPasses.cpp
@@ -13,11 +13,14 @@
 #include "mlir/IR/BuiltinOps.h"
 #include "mlir/Pass/PassManager.h"
 #include "clang/Basic/LangOptions.h"
+#include "clang/CIR/CIRPassPlugin.h"
 #include "clang/CIR/Dialect/IR/CIRDialect.h"
 #include "clang/CIR/Dialect/Passes.h"
 #include "llvm/Support/TimeProfiler.h"
 #include "llvm/TargetParser/Triple.h"
 
+LLVM_INSTANTIATE_REGISTRY_EX(CLANG_ABI_EXPORT, cir::CIRPassPluginRegistry)
+
 namespace cir {
 
 /// Map a target triple to the ABI target that drives CallConvLowering.
@@ -94,6 +97,11 @@ runCIRToCIRPasses(mlir::ModuleOp theModule, mlir::MLIRContext &mlirContext,
            << "' attribute";
 
   mlir::PassManager pm(&mlirContext);
+
+  for (const CIRPassPluginRegistry::entry &plugin :
+       CIRPassPluginRegistry::entries())
+    plugin.instantiate()->registerPasses(pm);
+
   pm.addPass(mlir::createCIRCanonicalizePass());
 
   if (enableCIRSimplify)
diff --git a/clang/tools/clang-shlib/simple_version_script.map.in b/clang/tools/clang-shlib/simple_version_script.map.in
index b2cbc9760..ba4801ef7 100644
--- a/clang/tools/clang-shlib/simple_version_script.map.in
+++ b/clang/tools/clang-shlib/simple_version_script.map.in
@@ -1,16 +1,6 @@
 @LLVM_SHLIB_SYMBOL_VERSION@ {
   global: *;
 
-  # ClangIR components are kept as an internal implementation detail, as
-  # otherwise the cost of loading/dynamically linking these symbols is onerous.
-  # This likely means that users of libclang-cpp.so won't be able to
-  # independently call ClangIR components, but that is not a supported feature.
-  # AS this script is used only on Itanium dylib builds, we can use the mangled
-  # names here, which saves multiple-percent in at link time, since the linker
-  # doesn't have to demangle every symbol.
-  # We exclude mlir::, cir::, and clang::CIRGen namespace symbols.
-  local:
-    *[NKVRO]4mlir*;
-    *[NKVRO]3cir*;
-    *[NKVRO]5clang6CIRGen*;
+  # ClangIR (mlir::, cir::, clang::CIRGen) stays exported so -fplugin
+  # CIR pass plugins can link against it.
 };
